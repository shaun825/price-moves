{
  // Price Moves – Cloudflare Workers config
  "name": "price-moves",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "www.pricemoves.co.za", "custom_domain": true }
  ],
  "observability": { "enabled": true }
  // Secret AIRTABLE_TOKEN is set by the GitHub deploy workflow from the repo's secrets; never commit it.
}
